# Zero-Trust Mesh - Environment Configuration

# Proxy Server
PROXY_PORT=4000
PROXY_HOST=localhost
NODE_ENV=development

# Database (if using Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/zerotrust

# Redis (for caching and state)
REDIS_URL=redis://localhost:6379
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Frontend
NEXT_PUBLIC_PROXY_HOST=localhost
NEXT_PUBLIC_PROXY_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Security
BETTER_AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
JWT_ALGORITHM=EdDSA

# Feature Flags
ENABLE_ATTACK_SIMULATOR=true
ENABLE_METRICS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_WEBSOCKET=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Performance
PROXY_TIMEOUT=30000
MAX_REQUEST_SIZE=10mb
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=1000
